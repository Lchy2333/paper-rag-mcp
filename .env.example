# ── RAG 服务（数据所有者）──
RAG_BASE_URL=http://localhost:8080
# MCP 专属的服务级密钥（与 RAG 侧 server.api_key 保持一致；为空 = RAG 未启用鉴权）
# ⚠️ 只存在于本进程环境变量，不得下发到任何终端用户环境，不写入日志/响应体
RAG_API_KEY=

# ── Agent（身份校验方）──
# MCP 用 Bearer JWT 调 POST {AGENT_BASE_URL}/api/auth/introspect 换取可信 user_id
AGENT_BASE_URL=http://localhost:8000

# ── MCP 传输 ──
# stdio = 本地单人；streamable-http = 多人共用（需配 HOST/PORT，且部署在内网）
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765

# stdio 模式的用户身份：用户 JWT（PAPER_RAG_TOKEN）
# 推荐留空，运行 `python login.py` 通过浏览器登录自动写入凭据文件；
# 本项是手工覆盖入口，优先级高于凭据文件。
# ⚠️ 属敏感信息，不要提交到版本库；⚠️ 禁止填 admin 的 token（会让 LLM 以管理员身份读全库）
# streamable-http 模式忽略本项与凭据文件，身份从每次请求的 Authorization 头取
PAPER_RAG_TOKEN=

# login.py 写入的凭据文件路径（留空 = ~/.paper-rag-mcp/credentials.json）
PAPER_RAG_CREDENTIALS_FILE=

# ── 超时（秒）──
SEARCH_TIMEOUT=90
CONNECT_TIMEOUT=15
INTROSPECT_TIMEOUT=5
# introspection 缓存 TTL；实际 TTL 不会超过 token 剩余有效期
INTROSPECT_CACHE_TTL=60

# ── 出参限额 ──
MAX_TOP_K=20
MAX_CHUNK_CHARS=2000
MAX_RESPONSE_BYTES=65536
